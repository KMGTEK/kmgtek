# Non-secret configuration for @kmg/api (ConfigMap `kmg-config`).
# Secrets (DATABASE_URL, JWT_ACCESS_SECRET, S3 keys, SMTP, OAuth) live in the
# Secret `kmg-secrets` — see secret.example.yaml. Overlays override values here.
NODE_ENV=production
API_PORT=4000
LOG_LEVEL=info

WEB_URL=https://kmgtek.com
CORS_ORIGINS=https://kmgtek.com,https://www.kmgtek.com
COOKIE_SECURE=true
COOKIE_DOMAIN=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

RATE_LIMIT_PER_MINUTE=120

STORAGE_DRIVER=s3
S3_REGION=us-east-1
S3_BUCKET_PUBLIC=kmg-public
S3_BUCKET_PRIVATE=kmg-private
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=https://cdn.kmgtek.com
SIGNED_URL_TTL_SECONDS=300

MAIL_DRIVER=smtp
SMTP_PORT=587
SMTP_SECURE=false
MAIL_FROM_NAME=KMG Technologies
MAIL_FROM_ADDRESS=recruiting@kmgtek.com
MAIL_NOTIFY_ADDRESSES=recruiting@kmgtek.com

GOOGLE_CALLBACK_URL=https://kmgtek.com/api/v1/auth/google/callback
LINKEDIN_CALLBACK_URL=https://kmgtek.com/api/v1/auth/linkedin/callback

# Never seed demo content outside of staging.
SEED_DEMO_DATA=false
