# Staging overrides (merged on top of base/config.env).
LOG_LEVEL=debug
WEB_URL=https://staging.kmgtek.com
CORS_ORIGINS=https://staging.kmgtek.com
S3_BUCKET_PUBLIC=kmg-staging-public
S3_BUCKET_PRIVATE=kmg-staging-private
S3_PUBLIC_URL=https://staging.kmgtek.com/media
GOOGLE_CALLBACK_URL=https://staging.kmgtek.com/api/v1/auth/google/callback
LINKEDIN_CALLBACK_URL=https://staging.kmgtek.com/api/v1/auth/linkedin/callback
RATE_LIMIT_PER_MINUTE=240
SEED_DEMO_DATA=true
